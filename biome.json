{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!assets",
      "!public",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!**/*.html",
      "!**/*.svg",
      "!src/**/*.json",
      "!tools/**/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "preserve"
    }
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noFocusedTests": "off",
        "noDuplicateTestHooks": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/e2e/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ]
}
